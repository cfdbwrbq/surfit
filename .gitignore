# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Python bytecode (the tree now contains Python as well)
__pycache__/
*.pyc

# Build trees (CMake and Python wheel builds)
build/
build-*/
dist/
*.egg-info/

# Logs the engine writes into the working directory
*.log

# Sphinx output
docs/_build/
